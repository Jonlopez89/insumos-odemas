# Initial data catalogs — NEVER commit real PII
# Only the README and explicit *.sample.* files may live in data/initial/
data/initial/*
!data/initial/README.md
!data/initial/*.sample.csv
!data/initial/*.sample.xlsx
!data/initial/.gitkeep

